{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/inbound-email",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/reports",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/outreach-sequences",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/vendor-monitoring",
      "schedule": "13 6 * * *"
    },
    {
      "path": "/api/cron/approval-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/activation-reminders",
      "schedule": "15 */6 * * *"
    }
  ]
}
