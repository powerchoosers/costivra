# Public configuration — safe to expose to the browser.
# Keep the Supabase project URL until auth.costivra.ai has been DNS-verified,
# SSL-activated, and tested. Only then
# replace this with https://auth.costivra.ai in Vercel and local environments.
NEXT_PUBLIC_SUPABASE_URL=https://skfocjrykyvsaviyhdea.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical production origin used in emailed auth redirects.
NEXT_PUBLIC_SITE_URL=https://costivra.ai
# Enable only after the matching provider is active in Supabase Auth and
# https://costivra.ai/auth/callback is in the Supabase redirect allowlist.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=0
NEXT_PUBLIC_MICROSOFT_OAUTH_ENABLED=0

# Stripe Billing / Checkout / Portal configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep this at 0 while using the Costivra Stripe test account. Set to 1 only
# after live pricing, tax, legal, and support procedures are approved.
STRIPE_BILLING_LIVEMODE_ENABLED=0
# Legacy bootstrap fallback for the owner-managed billing catalog. These are
# used only until the catalog has a saved Stripe Price for the current mode.
# Enterprise remains assisted-sales only until approved.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=

# Server-only configuration — never prefix these with NEXT_PUBLIC_.
# Use the Secret key from the Costivra Supabase project, not the Luxor project.
SUPABASE_SECRET_KEY=

# The existing Luxor key uses this name. Set it in your local environment and Vercel;
# do not put its value in this file.
OPEN_ROUTER_API_KEY=
OPENROUTER_PDF_ENGINE=mistral-ocr
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Internal CRM enrichment only. Keep this server-side; never expose Apollo data
# in the customer portal without Apollo's required data-sharing agreement.
APOLLO_API_KEY=

# Transactional email. RESEND_API_KEY is server-only and must be stored in Vercel/local ignored env files.
RESEND_API_KEY=
LOGODEV_API_KEY=
# Logo.dev image URLs require a publishable `pk_` token. Prefer this name for new setups.
LOGODEV_PUBLISHABLE_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=costivra.ai
RESEND_FROM_EMAIL=Costivra <hello@costivra.ai>
# Monitored human recipient for warning/critical service alerts. Never use a
# reserved or example domain in a live environment.
COSTIVRA_OPERATIONS_ALERT_EMAIL=
COSTIVRA_ALERT_MIN_SEVERITY=warning
COSTIVRA_ALERT_REMINDER_MINUTES=60
COSTIVRA_OPERATIONS_ALERT_REPLY_TO=
CONTACT_NOTIFICATION_EMAIL=l.patterson@costivra.ai
# Random server-only value (16+ characters). Vercel sends it as a Bearer token
# when invoking the protected inbound-email worker every minute.
CRON_SECRET=
# Keep false until Packet 07 sequence sends, suppression, and recovery proof is complete.
COSTIVRA_SEQUENCE_EXECUTION_ENABLED=false

# Private-data retention runs daily in report-only mode unless enforcement is
# explicitly enabled. Quarantine defaults to 30 days. Original source files are
# never purged until RETENTION_ORIGINAL_DAYS is deliberately set.
RETENTION_ENFORCEMENT_ENABLED=0
RETENTION_QUARANTINE_DAYS=30
RETENTION_ORIGINAL_DAYS=
RETENTION_BATCH_SIZE=100

# Comma-separated authenticated emails allowed to open the internal /manage portal.
# Customer organization roles never grant this cross-tenant access.
COSTIVRA_INTERNAL_ADMIN_EMAILS=l.patterson@costivra.ai

# Required before an emailed attachment may leave private quarantine.
# The service receives multipart form-data with a `file` field and must return
# JSON such as: { "clean": true } or { "infected": true, "signature": "..." }.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
# Direct Cloudmersive support is available as the simpler alternative to the generic adapter.
CLOUDMERSIVE_API_KEY=
# Founder-confirmed authenticated plan allowance. Keep values server-only.
CLOUDMERSIVE_MONTHLY_REQUEST_LIMIT=800
CLOUDMERSIVE_MONTHLY_REQUEST_RESERVE=20
# One request per second with jitter protection; never lower than 1100ms.
CLOUDMERSIVE_MIN_INTERVAL_MS=1100
# Confirm the exact provider maximum in the authenticated dashboard.
CLOUDMERSIVE_MAX_FILE_BYTES=3500000
CLOUDMERSIVE_TIMEOUT_MS=30000

# Explicitly gated disposable-user browser regression. Keep the secret server-only.
# Remote targets also require E2E_ALLOW_PRODUCTION=1 to prevent accidental writes.
RUN_AUTHENTICATED_E2E=0
E2E_ALLOW_PRODUCTION=0
E2E_SUPABASE_SECRET_KEY=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
