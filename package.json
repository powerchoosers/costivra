{
  "name": "costivra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:live": "cross-env RUN_LIVE_SUPABASE_TESTS=1 node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/authenticated-workspace.spec.ts --project=desktop-chromium",
    "eval:invoices": "tsx --env-file-if-exists=.env.local scripts/evaluate-invoice-extraction.ts",
    "eval:pilot": "tsx --env-file-if-exists=.env.local scripts/evaluate-pilot.ts",
    "eval:categories": "tsx --env-file-if-exists=.env.local scripts/evaluate-category-intelligence.ts categories",
    "eval:line-items": "tsx --env-file-if-exists=.env.local scripts/evaluate-category-intelligence.ts line_items",
    "eval:benchmarks": "tsx --env-file-if-exists=.env.local scripts/evaluate-category-intelligence.ts benchmarks",
    "eval:market-research": "tsx --env-file-if-exists=.env.local scripts/evaluate-category-intelligence.ts market_research",
    "ops:readiness": "tsx --env-file-if-exists=.env.local scripts/ops-readiness.ts",
    "ops:smoke": "tsx --env-file-if-exists=.env.local scripts/ops-smoke.ts",
    "ops:verify": "npm run ops:readiness && npm run ops:smoke",
    "ops:cloudmersive": "tsx --env-file-if-exists=.env.local scripts/verify-cloudmersive.ts",
    "ops:cloudmersive:eicar": "tsx --env-file-if-exists=.env.local scripts/verify-cloudmersive.ts --eicar",
    "security:secrets": "tsx scripts/secret-scan.ts",
    "release:verify": "tsx scripts/release-verdict.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "lenis": "^1.3.26",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^10.4.1",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
